    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "docker build . --pull -f linux.Dockerfile -t gamesvr-blackmesa --no-cache --build-arg BUILDNODE=$env:computername;",
            "group": "build",
            "problemMatcher": [],
            "promptOnClose": true
        },
        {
            "label": "Build & Run Interactive Server",
            "type": "shell",
            "command": "docker run -it --net=host gamesvr-blackmesa ./srcds_run -game bms +map gasworks -insecure -maxplayers 8 +sv_lan 1 +userrcon +rcon_password \"test123\";",
            "dependsOn": "Build",
            "group": "build",
            "problemMatcher": [],
            "promptOnClose": true
        },
        {
            "label": "Build & Shell In",
            "type": "shell",
            "command": "docker run -it --net=host --rm gamesvr-blackmesa;",
            "dependsOn": "Build",
            "group": "build",
            "problemMatcher": [],
            "promptOnClose": true
        }
    ]
}
